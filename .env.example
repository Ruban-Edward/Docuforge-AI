# ==============================================================================
# DocuForge AI – Environment Configuration
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="DocuForge AI"
API_V1_STR=/api/v1

# --- Security & JWT Authentication ---
# Secret key used for signing JWT tokens. Change in production!
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Admin user seed credentials
INITIAL_ADMIN_EMAIL=admin@docuforge.ai
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=DocuForgeAdmin2026!
INITIAL_ADMIN_FULL_NAME="System Administrator"

# --- Database Configuration ---
POSTGRES_USER=docuforge_user
POSTGRES_PASSWORD=docuforge_secure_password
POSTGRES_DB=docuforge_db
POSTGRES_PORT=5432

# When running via Docker Compose, the database service is named "db":
POSTGRES_HOST=db
DATABASE_URL=postgresql+asyncpg://docuforge_user:docuforge_secure_password@db:5432/docuforge_db

# When running backend locally outside Docker (Workflow B), use localhost:
# DATABASE_URL=postgresql+asyncpg://docuforge_user:docuforge_secure_password@localhost:5432/docuforge_db
# For lightweight testing without PostgreSQL running:
# DATABASE_URL=sqlite+aiosqlite:///./docuforge_dev.db

# --- Storage Configuration ---
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=20

# --- CORS & Networking ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- External AI Provider ---
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=your-api-key-here
AI_MODEL_NAME=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=60

